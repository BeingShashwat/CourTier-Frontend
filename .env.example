# ==============================================================================
# CourTier — Master Environment Variable Template (.env.example)
# Copy this file to '.env' and fill in values. Do NOT commit the '.env' file.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATIONS (Vite / React)
# ──────────────────────────────────────────────────────────────────────────────
# Base URL to the backend API scraper gateway service (Nginx or directly to port 8080)
# - Development: http://localhost:8080
# - Production: https://api.courtier.in
VITE_API_URL=http://localhost:8080

# Environment execution mode (development | production | test)
NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND CONFIGURATIONS (Spring Boot / Java)
# ──────────────────────────────────────────────────────────────────────────────
# Active Spring profiles (dev | prod | test)
SPRING_PROFILES_ACTIVE=dev

# Server listening port (default: 8080)
PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/courtier
SPRING_DATASOURCE_USERNAME=courtier_user
SPRING_DATASOURCE_PASSWORD=StrongSecurePassword

# Redis Configuration (Captcha & Session Cache)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Apache Kafka Broker Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Authentication Configs
JWT_SECRET=SUPER_LONG_SECRET_KEY_FOR_JWT_SIGNING_MIN_256_BITS
JWT_EXPIRATION_MS=86400000          # 24 Hours
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 Days

# eCourts Portal Scraper Gateway API Key (if any third-party gateway is used)
ECOURTS_GATEWAY_API_KEY=your_ecourts_gateway_token_here
